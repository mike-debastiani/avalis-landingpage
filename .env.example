# Siehe docs/03_tech-architecture.md Abschnitt 3.
# Diese Datei enthält keine echten Werte. Lokale Werte gehören in .env.local (gitignored).

# Geheim: API-Key von Brevo. Nie im Client, nie in Logs, nie in Docs.
BREVO_API_KEY=

# ID der Liste "Avalis Registrierungen" in Brevo.
BREVO_LIST_ID=

# ID des Brevo-Transaktions-Templates "Research Report" (Mail mit Download-Link).
BREVO_REPORT_TEMPLATE_ID=

# Geheim: Zufälliger Schlüssel (mind. 32 Zeichen), mit dem die Abmeldelinks in der
# Report-Mail signiert werden. Erzeugen z.B. mit: openssl rand -base64 32
UNSUBSCRIBE_SECRET=

# Basis-URL der Seite, z.B. https://….vercel.app, später eigene Domain.
NEXT_PUBLIC_SITE_URL=

# Google-Drive-Link zum Research Report. Wird nur serverseitig an Brevo übergeben
# und per Mail verschickt, nie an den Browser ausgeliefert.
REPORT_DOWNLOAD_URL=

# Geheim: Nur falls Cloudflare Turnstile verwendet wird.
TURNSTILE_SECRET_KEY=

# Nur falls Cloudflare Turnstile verwendet wird.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
